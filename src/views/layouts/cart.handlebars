<h2>Contenido del Carrito (ID: {{id_carrito}})</h2>

{{#if productos.length}}
    <div style="display: flex; flex-direction: column; gap: 1rem;">
        {{#each productos}}
            <div style="display: flex; align-items: center; justify-content: space-between; border: 1px solid #ccc; padding: 16px; border-radius: 8px; background-color: #f9f9f9;">
                
                <div style="flex-grow: 1;">
                    <h3 style="margin-top: 0; margin-bottom: 8px;">{{this.product.title}}</h3>
                    <p style="margin: 4px 0;"><strong>Precio unitario:</strong> ${{this.product.price}}</p>
                    <p style="margin: 4px 0;"><strong>Cantidad:</strong> {{this.quantity}}</p>
                </div>
                
                <div style="text-align: right;">
                    <p style="font-weight: bold; font-size: 1.1em; margin-bottom: 12px;"><strong>Subtotal:</strong> ${{this.subtotal}}</p>
                    <button 
                        onclick="eliminarDelCarrito('{{../id_carrito}}', '{{this.product._id}}')" 
                        style="background-color: #e74c3c; color: white; border: none; padding: 8px 12px; border-radius: 5px; cursor: pointer; font-weight: bold;"
                        onmouseover="this.style.backgroundColor='#c0392b'" 
                        onmouseout="this.style.backgroundColor='#e74c3c'"
                    >
                        Eliminar
                    </button>
                </div>
            </div>
        {{/each}}
    </div>
    
    <hr style="margin-top: 2rem; margin-bottom: 1rem;">
    
    <div style="text-align: right; font-size: 1.5em; font-weight: bold;">
        <h3 style="margin: 0;">Total del Carrito: ${{total}}</h3>
    </div>

{{else}}
    <p>Este carrito está vacío.</p>
{{/if}}

<script>
    async function eliminarDelCarrito(cartId, productId) {
        if (!confirm('¿Estás seguro de que quieres eliminar este producto del carrito?')) {
            return;
        }
        try {
            const response = await fetch(`/api/carts/${cartId}/products/${productId}`, {
                method: 'DELETE'
            });
            if (response.ok) {
                alert('Producto eliminado con éxito.');
                window.location.reload();
            } else {
                alert('Error al eliminar el producto del carrito.');
            }
        } catch (error) {
            console.error('Error:', error);
            alert('Hubo un error de conexión.');
        }
    }
</script>