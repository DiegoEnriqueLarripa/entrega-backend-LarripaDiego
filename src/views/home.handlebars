<h2>Lista de Productos Paginados</h2>

<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 1rem;">
    {{#if productos.length}}
        {{#each productos}}
            <div style="border: 1px solid #ccc; padding: 1rem; border-radius: 8px; height: 100%; display: flex; flex-direction: column; justify-content: space-between;">
                
                <div>
                    <h3>{{this.title}}</h3>
                    <p>{{this.description}}</p>
                    <p><strong>Categoría:</strong> {{this.category}}</p>
                    <p><strong>Precio:</strong> ${{this.price}}</p>
                    <p><strong>Stock:</strong> {{this.stock}} unidades</p>
                </div>

                <div style="margin-top: 1rem; display: flex; flex-direction: column; gap: 10px;">
                    
                    <a href="/products/{{this._id}}" 
                       style="background-color: #f0f0f0; color: #333; border: 1px solid #ccc; text-align: center; padding: 10px; border-radius: 5px; text-decoration: none; font-weight: bold;"
                    >
                        Ver detalles
                    </a>
                    
                    <button 
                        onclick="agregarAlCarrito('{{this._id}}')" 
                        style="background-color: #3498db; color: white; border: none; padding: 10px; border-radius: 5px; cursor: pointer; font-weight: bold;"
                    >
                        Agregar al Carrito
                    </button>

                </div>
            </div>
        {{/each}}
    {{else}}
        <p>No hay productos para mostrar en esta vista.</p>
    {{/if}}
</div>

<hr>

<div style="display: flex; justify-content: center; align-items: center; margin-top: 2rem;">
    {{#if hasPrevPage}}
        <a href="{{prevLink}}" style="padding: 10px 20px; border: 1px solid #007bff; text-decoration: none; color: #007bff; border-radius: 5px;">
            &laquo; Página Anterior
        </a>
    {{/if}}
    <span style="margin: 0 1rem;">Página <strong>{{page}}</strong> de <strong>{{totalPages}}</strong></span>
    {{#if hasNextPage}}
        <a href="{{nextLink}}" style="padding: 10px 20px; border: 1px solid #007bff; text-decoration: none; color: #007bff; border-radius: 5px;">
            Página Siguiente &raquo;
        </a>
    {{/if}}
</div>

